  requestedByUserId       String
  proposedStartAt         DateTime?
  proposedEndAt           DateTime?
  proposedEstimateMinutes Int?
  reason                  String
  status                  String          @default("PENDING")
  reviewedByUserId        String?
  reviewedAt              DateTime?
  reviewNote              String?
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt
  workspace               TenantWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project                 Project?        @relation(fields: [projectId], references: [id], onDelete: SetNull)
  task                    ProjectTask     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  requestedBy             User            @relation("TimelineChangeRequestedBy", fields: [requestedByUserId], references: [id])
  reviewedBy              User?           @relation("TimelineChangeReviewedBy", fields: [reviewedByUserId], references: [id])

  @@index([workspaceId, status, createdAt])
  @@index([projectId, status])
  @@index([taskId, createdAt])
}

// Immutable baseline/audit chain used by project history and P&L explanations.
model TaskPlanHistory {
  id               String          @id @default(cuid())
  workspaceId      String
  projectId        String?
  taskId           String
  version          Int
  action           String
  reason           String?
  before           Json?
  after            Json
  changedByUserId  String
  approvedByUserId String?
  changedAt        DateTime        @default(now())
  workspace        TenantWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project          Project?        @relation(fields: [projectId], references: [id], onDelete: SetNull)
  task             ProjectTask     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  changedBy        User            @relation("TaskPlanHistoryChangedBy", fields: [changedByUserId], references: [id])
  approvedBy       User?           @relation("TaskPlanHistoryApprovedBy", fields: [approvedByUserId], references: [id])

  @@unique([taskId, version])
  @@index([workspaceId, changedAt])
  @@index([projectId, changedAt])
}

// OT is kept separate from standard hours and only becomes financial after approval.
model OvertimePlan {
  id                String          @id @default(cuid())
  workspaceId       String
  projectId         String?
  userId            String
  workDate          DateTime        @db.Date
  plannedMinutes    Int
  reason            String
  approvalStatus    String          @default("PENDING")
  requestedByUserId String
  approvedByUserId  String?
  approvedAt        DateTime?
  reviewNote        String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  workspace         TenantWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project           Project?        @relation(fields: [projectId], references: [id], onDelete: SetNull)
  user              User            @relation("OvertimeForUser", fields: [userId], references: [id])
  requestedBy       User            @relation("OvertimeRequestedBy", fields: [requestedByUserId], references: [id])
  approvedBy        User?           @relation("OvertimeApprovedBy", fields: [approvedByUserId], references: [id])
  timeEntries       TaskTimeEntry[]

  @@index([workspaceId, workDate, approvalStatus])
  @@index([projectId, workDate])
  @@index([requestedByUserId, workDate])
}

// Effective-dated P1-P4 components; changing a new month never mutates a locked month.
model ResourceMonthlyCost {
  id                    String          @id @default(cuid())
  workspaceId           String
  userId                String
  periodStart           DateTime        @db.Date
  periodEnd             DateTime        @db.Date
  periodKey             String
  currency              String          @default("VND")
  p1BaseAmount          Decimal         @default(0)
  p2AllowanceAmount     Decimal         @default(0)
  p3PerformanceAmount   Decimal         @default(0)
  p4OtherVariableAmount Decimal         @default(0)
  overtimeAmount        Decimal         @default(0)
  socialInsuranceAmount Decimal         @default(0)
  pitAmount             Decimal         @default(0)
  otherAmount           Decimal         @default(0)
  totalMonthlyIncome    Decimal         @default(0)
  hourlyCostRate        Decimal?
  status                String          @default("DRAFT")
  source                String          @default("manual")
  lockedAt              DateTime?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  workspace             TenantWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user                  User            @relation(fields: [userId], references: [id])

  @@unique([workspaceId, userId, periodKey])
  @@index([workspaceId, periodStart, periodEnd])
  @@index([userId, periodStart, periodEnd])
  @@index([status])
}

// One period record is the authority for lock/reopen and reconciliation state.
model PnlPeriod {
  id                String                   @id @default(cuid())
  workspaceId       String
  projectId         String?
  periodStart       DateTime                 @db.Date
  periodEnd         DateTime                 @db.Date
  periodKey         String
  currency          String                   @default("VND")
  revenueAmount     Decimal                  @default(0)
  status            String                   @default("OPEN")
  confirmedByUserId String?
  confirmedAt       DateTime?
  lockedByUserId    String?
  lockedAt          DateTime?
  reopenedByUserId  String?
  reopenedAt        DateTime?
  reopenReason      String?
  formulaVersion    Int                      @default(1)
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  workspace         TenantWorkspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project           Project?                 @relation(fields: [projectId], references: [id], onDelete: SetNull)
  confirmedBy       User?                    @relation("PnlPeriodConfirmedBy", fields: [confirmedByUserId], references: [id])
  lockedBy          User?                    @relation("PnlPeriodLockedBy", fields: [lockedByUserId], references: [id])
  reopenedBy        User?                    @relation("PnlPeriodReopenedBy", fields: [reopenedByUserId], references: [id])
  allocations       PnlTimeEntryAllocation[]

  @@unique([workspaceId, projectId, periodKey])
  @@index([workspaceId, periodStart, periodEnd, status])
  @@index([projectId, periodStart, periodEnd])
}

// Materialized classification of every worklog; this is what makes P&L auditable.
model PnlTimeEntryAllocation {
  id                 String          @id @default(cuid())
  workspaceId        String
  periodId           String
  timeEntryId        String          @unique
  status             String          @default("PENDING")
  reason             String?
  standardMinutes    Int             @default(0)
  overtimeMinutes    Int             @default(0)
  hourlyCostRate     Decimal?
  laborCostAmount    Decimal?
  classifiedAt       DateTime?
  classifiedByUserId String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  workspace          TenantWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  period             PnlPeriod       @relation(fields: [periodId], references: [id], onDelete: Cascade)
  timeEntry          TaskTimeEntry   @relation(fields: [timeEntryId], references: [id], onDelete: Cascade)

  @@index([workspaceId, status])
  @@index([periodId, status])
}

model ReminderDeliveryLog {
  id             String          @id @default(cuid())
  workspaceId    String
  localDate      DateTime        @db.Date
  moment         String
  userId         String
  pmUserId       String?
  missingType    String
  conditionKey   String
  channel        String          @default("lark")
  deliveryStatus String          @default("PENDING")
  attemptCount   Int             @default(0)
  deepLink       String?
  payload        Json?
  errorMessage   String?
  lastAttemptAt  DateTime?
  sentAt         DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  workspace      TenantWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user           User            @relation(fields: [userId], references: [id])
  pm             User?           @relation("ReminderPm", fields: [pmUserId], references: [id])

  @@unique([workspaceId, localDate, moment, userId, missingType])
  @@index([workspaceId, localDate, moment, deliveryStatus])
  @@index([userId, localDate])
}

model WorkspaceReminderPolicy {
  id              String          @id @default(cuid())
  workspaceId     String          @unique
  enabled         Boolean         @default(true)
  timezone        String          @default("Asia/Ho_Chi_Minh")
  slots           Json
  weekdaysOnly    Boolean         @default(true)
  updatedByUserId String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  workspace       TenantWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  updatedBy       User?           @relation("WorkspaceReminderPolicyUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@index([workspaceId, enabled])
  @@index([updatedByUserId])
}

model CustomerAccessGrant {
  id          String          @id @default(cuid())
  workspaceId String          @default("twk-foundation")
  userId      String
  accountId   String?
  projectId   String?
  scope       ScopeType
  startsAt    DateTime        @default(now())
  endsAt      DateTime?
  createdAt   DateTime        @default(now())
  workspace   TenantWorkspace @relation(fields: [workspaceId], references: [id])
  user        User            @relation(fields: [userId], references: [id])
  account     Account?        @relation(fields: [accountId], references: [id])
  project     Project?        @relation(fields: [projectId], references: [id])

  @@index([workspaceId])
  @@index([userId, accountId])
  @@index([userId, projectId])
}

model PortalInvitation {
  id                 String                 @id @default(cuid())
  workspaceId        String                 @default("twk-foundation")
  tenantKey          String
  invitedEmail       String
  requestedEmail     String?
  requestedOpenId    String?
  requestedTenantKey String?
  requestedName      String?
  accountId          String?
  projectId          String?
  scope              ScopeType
  roleCode           String
  tokenHash          String                 @unique
  status             PortalInvitationStatus @default(PENDING)
  invitedByUserId    String
  activatedUserId    String?
  reviewReason       String?
  expiresAt          DateTime
  consumedAt         DateTime?
  revokedAt          DateTime?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  workspace          TenantWorkspace        @relation(fields: [workspaceId], references: [id])

  @@index([workspaceId, status])
  @@index([tenantKey, invitedEmail])
  @@index([status, expiresAt])
  @@index([accountId])
  @@index([projectId])
}

model ProjectProgressShareLink {
  id              String          @id @default(cuid())
  workspaceId     String          @default("twk-foundation")
  accountId       String
  projectId       String
  tokenHash       String          @unique
  label           String?
  viewerEmail     String?
  viewerDomain    String?
  createdByUserId String
  revokedByUserId String?
  expiresAt       DateTime
  revokedAt       DateTime?
  lastAccessedAt  DateTime?
  accessCount     Int             @default(0)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  workspace       TenantWorkspace @relation(fields: [workspaceId], references: [id])
  account         Account         @relation(fields: [accountId], references: [id])
  project         Project         @relation(fields: [projectId], references: [id])
  createdBy       User            @relation("ProgressShareCreatedBy", fields: [createdByUserId], references: [id])
  revokedBy       User?           @relation("ProgressShareRevokedBy", fields: [revokedByUserId], references: [id])

  @@index([workspaceId])
  @@index([accountId])
  @@index([projectId, expiresAt])
  @@index([createdByUserId])
  @@index([revokedAt])
}

model FieldPolicy {
  id           String           @id @default(cuid())
  resource     Resource
  fieldName    String
  sensitivity  FieldSensitivity
  allowedRoles String[]
  projection   ProjectionMode   @default(OMIT)
  createdAt    DateTime         @default(now())

  @@unique([resource, fieldName])
}

model PolicyDecisionLog {
  id          String           @id @default(cuid())
  workspaceId String?
  userId      String?
  subjectType SubjectType
  action      Action
  resource    Resource
  resourceId  String?
  decision    DefaultDecision
  reason      String
  requestId   String
  context     Json
  createdAt   DateTime         @default(now())
  workspace   TenantWorkspace? @relation(fields: [workspaceId], references: [id])
  user        User?            @relation(fields: [userId], references: [id])

  @@index([workspaceId, createdAt])
  @@index([requestId])
  @@index([resource, action, decision])
  @@index([createdAt])
}

model IntegrationEventLog {
  id              String                 @id @default(cuid())
  workspaceId     String?
  provider        String
  eventType       String
  externalEventId String
  idempotencyKey  String                 @unique
  status          IntegrationEventStatus @default(RECEIVED)
  payload         Json
  receivedAt      DateTime               @default(now())
  processedAt     DateTime?
  errorMessage    String?
  workspace       TenantWorkspace?       @relation(fields: [workspaceId], references: [id])

  @@unique([provider, externalEventId])
  @@index([workspaceId, status])
  @@index([eventType, status])
}

model AuditEvent {
  id          String           @id @default(cuid())
  workspaceId String?
  actorUserId String?
  action      String
  resource    String
  resourceId  String?
  before      Json?
  after       Json?
  requestId   String
  createdAt   DateTime         @default(now())
  workspace   TenantWorkspace? @relation(fields: [workspaceId], references: [id])

  @@index([workspaceId, createdAt])
  @@index([resource, resourceId])
  @@index([requestId])
}

// Workspace-scoped, effective-dated membership model for workforce analytics.
// Legacy global fields (User.departmentCode, Team, TeamMember) stay read-compatible
// during cutover; these tables are the analytics source of truth for coverage.

model Department {
  id             String                   @id @default(cuid())
  workspaceId    String
  code           String
  name           String
  active         Boolean                  @default(true)
  source         String                   @default("manual")
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  workspace      TenantWorkspace          @relation(fields: [workspaceId], references: [id])
  memberProfiles WorkspaceMemberProfile[]

  @@unique([workspaceId, code])
  @@index([workspaceId, active])
}

model WorkspaceTeam {
  id                    String                   @id @default(cuid())
  workspaceId           String
  code                  String
  name                  String
  active                Boolean                  @default(true)
  source                String                   @default("manual")
  sourceTeamId          String?
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt
  workspace             TenantWorkspace          @relation(fields: [workspaceId], references: [id])
  members               WorkspaceTeamMember[]
  primaryMemberProfiles WorkspaceMemberProfile[] @relation("WorkspaceMemberPrimaryTeam")

  @@unique([workspaceId, code])
  @@index([workspaceId, active])
}

model WorkspaceTeamMember {
  id            String          @id @default(cuid())
  workspaceId   String
  teamId        String
  userId        String
  effectiveFrom DateTime
  effectiveTo   DateTime?
  source        String          @default("manual")
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  workspace     TenantWorkspace @relation(fields: [workspaceId], references: [id])
  team          WorkspaceTeam   @relation(fields: [teamId], references: [id])
  user          User            @relation(fields: [userId], references: [id])

  @@unique([workspaceId, teamId, userId, effectiveFrom])
  @@index([workspaceId, userId, effectiveFrom])
  @@index([teamId, effectiveFrom])
  @@index([userId])
}

model WorkspaceMemberProfile {
  id                    String          @id @default(cuid())
  workspaceId           String
  userId                String
  departmentId          String?
  primaryTeamId         String?
  weeklyCapacityMinutes Int?
  billableTargetPercent Int?
  effectiveFrom         DateTime
  effectiveTo           DateTime?
  source                String          @default("manual")
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  workspace             TenantWorkspace @relation(fields: [workspaceId], references: [id])
  user                  User            @relation(fields: [userId], references: [id])
  department            Department?     @relation(fields: [departmentId], references: [id])
  primaryTeam           WorkspaceTeam?  @relation("WorkspaceMemberPrimaryTeam", fields: [primaryTeamId], references: [id])

  @@unique([workspaceId, userId, effectiveFrom])
  @@index([workspaceId, userId])
  @@index([workspaceId, departmentId])
  @@index([workspaceId, primaryTeamId])
  @@index([userId])
}

model AnalyticsSavedView {
  id          String          @id @default(cuid())
  workspaceId String
  ownerUserId String
  name        String          @db.VarChar(80)
  searchState String          @db.VarChar(1500)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  workspace   TenantWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  owner       User            @relation("AnalyticsSavedViewOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, ownerUserId, name])
  @@index([workspaceId, ownerUserId, updatedAt(sort: Desc)])
}

// Durable receipt survives project deletion so replay cannot recreate a deleted project.
model ProjectCreateReceipt {
  keyHash     String   @id
  workspaceId String
  actorUserId String
  requestHash String
  projectId   String
  response    Json
  createdAt   DateTime @default(now())

  @@index([workspaceId, actorUserId, createdAt])
}
