generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SubjectType {
  INTERNAL_USER
  PORTAL_USER
  SERVICE_ACCOUNT
}

enum SubjectStatus {
  ACTIVE
  SUSPENDED
}

enum RoleType {
  SYSTEM
  BUSINESS
  PORTAL
  SERVICE
}

enum Action {
  LIST
  READ
  CREATE
  UPDATE
  APPROVE
  EXPORT
  DOWNLOAD
  DELETE
}

enum Resource {
  ACCOUNT
  OPPORTUNITY
  PROPOSAL
  PROJECT
  TASK
  CONTRACT
  PAYMENT
  CAPACITY
  DASHBOARD
  INTEGRATION_EVENT
  POLICY_DECISION
  TICKET
  ARTIFACT
}

enum ScopeType {
  GLOBAL
  TEAM
  OWNED
  ASSIGNED_ACCOUNT
  ASSIGNED_PROJECT
  CUSTOMER_ACCOUNT
  CUSTOMER_PROJECT
  NONE
}

enum DefaultDecision {
  ALLOW
  DENY
}

enum FieldSensitivity {
  PUBLIC
  INTERNAL
  COMMERCIAL
  FINANCIAL
  CONFIDENTIAL
}

enum ProjectionMode {
  FULL
  MASK
  OMIT
}

enum AccountMemberRelation {
  OWNER
  COLLABORATOR
  DELIVERY_LEAD
  FINANCE_OWNER
}

enum IntegrationEventStatus {
  RECEIVED
  VALIDATED
  PROCESSED
  FAILED
  IGNORED
}

enum PortalInvitationStatus {
  PENDING
  REVIEW_REQUIRED
  ACCEPTED
  REVOKED
  EXPIRED
  REJECTED
}

enum ProposalPackageType {
  QUICK_SETUP_DISCOVERY
  STANDARD_IMPLEMENTATION
  COMPLEX_MULTI_PHASE
  MONTHLY_RETAINER_SUPPORT
  CHANGE_REQUEST
  LICENSE_SUBSCRIPTION_PASS_THROUGH
}

enum ProposalPackageStatus {
  DRAFT
  INTERNAL_REVIEW
  REVISION_REQUIRED
  INTERNALLY_APPROVED
  SENT_TO_CUSTOMER
  CUSTOMER_REVISION_REQUESTED
  CUSTOMER_ACCEPTED
  SUPERSEDED
  WITHDRAWN
  EXPIRED
}

enum ProposalDocumentType {
  PROPOSAL
  SOW
  QUOTATION
  PAYMENT_SCHEDULE
  RISK_REGISTER
  APPENDIX
  VENDOR_QUOTE
  CUSTOMER_ACCEPTANCE
  OTHER
}

enum DealApprovalRequestType {
  PROPOSAL_READINESS
  DISCOUNT
  PAYMENT_TERM
  SCOPE_RISK
  UNUSUAL_COMMITMENT
  LICENSE_PASS_THROUGH
  CHANGE_REQUEST_IMPACT
}

enum DealApprovalRequestStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  REVISION_REQUESTED
  CANCELLED
  EXPIRED
}

enum ScopeRiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ContractStatus {
  DRAFT
  INTERNAL_REVIEW
  READY_FOR_SIGNATURE
  SENT_FOR_SIGNATURE
  SIGNED
  ACTIVE
  VOIDED
  EXPIRED
}

enum ContractSignatureStatus {
  NOT_READY
  READY
  SENT
  SIGNED
  VOIDED
  EXPIRED
}

enum ContractDocumentType {
  CONTRACT_PDF
  SIGNED_CONTRACT
  APPENDIX
  SOW
  PAYMENT_SCHEDULE
  LEGAL_REVIEW
  OTHER
}

enum PaymentScheduleStatus {
  DRAFT
  ACTIVE
  SUPERSEDED
  CANCELLED
}

enum PaymentMilestoneStatus {
  PLANNED
  READY_FOR_FINANCE_REVIEW
  READY_TO_INVOICE
  INVOICED
  PARTIALLY_PAID
  PAID
  OVERDUE
  DISPUTED
  WAIVED
  CANCELLED
}

enum PaymentTriggerType {
  CONTRACT_SIGNING
  KICKOFF
  DELIVERY_STAGE
  ACCEPTANCE
  CALENDAR_DATE
  MONTHLY_RETAINER
  MANUAL
  OTHER
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  SENT
  CANCELLED
  VOIDED
}

enum InvoicePaymentStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
  OVERDUE
  DISPUTED
  WRITTEN_OFF
}

enum ArFollowUpStatus {
  OPEN
  SNOOZED
  RESOLVED
  CANCELLED
}

enum PaymentEvidenceType {
  INVOICE_FILE
  PAYMENT_RECEIPT
  BANK_TRANSFER
  CUSTOMER_CONFIRMATION
  ACCEPTANCE_EVIDENCE
  EXCEPTION_APPROVAL
  OTHER
}

enum ResourceAllocationStatus {
  REQUESTED
  TENTATIVE
  RESERVED
  CONFIRMED
  RELEASED
  CANCELLED
}

enum ProjectBudgetStatus {
  DRAFT
  ACTIVE
  LOCKED
  SUPERSEDED
}

enum ProjectCostType {
  LABOR
  EXTERNAL
  SOFTWARE
  TRAVEL
  WRITE_OFF
  OTHER
}

enum ProjectPlSnapshotStatus {
  DRAFT
  LOCKED
  SUPERSEDED
}

model AuthActionToken {
  id          String    @id @default(cuid())
  tokenHash   String    @unique
  purpose     String
  userId      String?
  workspaceId String?
  payload     Json?
  expiresAt   DateTime
  consumedAt  DateTime?
  createdAt   DateTime  @default(now())
  user        User?     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@index([expiresAt])
}

model AuthRateLimit {
  key       String   @id
  attempts  Int
  expiresAt DateTime

  @@index([expiresAt])
}

model User {
  id                             String                      @id @default(cuid())
  email                          String                      @unique
  passwordHash                   String?
  emailVerifiedAt                DateTime?
  mfaSecret                      String?
  mfaPendingSecret               String?
  mfaEnabledAt                   DateTime?
  mfaLastStep                    Int?
  mfaRecoveryHashes              String[]                    @default([])
  authActionTokens               AuthActionToken[]
  displayName                    String
  avatarUrl                      String?
  subjectType                    SubjectType                 @default(INTERNAL_USER)
  status                         SubjectStatus               @default(ACTIVE)
  departmentCode                 String?
  createdAt                      DateTime                    @default(now())
  updatedAt                      DateTime                    @updatedAt
  identities                     PortalIdentity[]
  sessions                       PortalSession[]
  roleBindings                   RoleBinding[]
  accountMembers                 AccountMember[]
  accountUsageReviews            AccountUsageReview[]
  picAccounts                    Account[]                   @relation("AccountPic")
  projectMembers                 ProjectMember[]
  createdActivities              OpportunityActivity[]
  stageChanges                   OpportunityStageHistory[]
  createdPaymentSchedules        PaymentSchedule[]           @relation("PaymentScheduleCreatedBy")
  createdPaymentMilestones       PaymentMilestone[]          @relation("PaymentMilestoneCreatedBy")
  financeOwnedMilestones         PaymentMilestone[]          @relation("PaymentMilestoneFinanceOwner")
  overdueOwnedMilestones         PaymentMilestone[]          @relation("PaymentMilestoneOverdueOwner")
  createdInvoices                Invoice[]                   @relation("InvoiceCreatedBy")
  ownedArFollowUps               ArFollowUp[]                @relation("ArFollowUpOwner")
  createdArFollowUps             ArFollowUp[]                @relation("ArFollowUpCreatedBy")
  createdPaymentEvidence         PaymentEvidence[]           @relation("PaymentEvidenceCreatedBy")
  invoicePayments                InvoicePayment[]            @relation("InvoicePaymentCreatedBy")
  resourceProfile                ResourceProfile?
  capacityPeriods                ResourceCapacityPeriod[]
  resourceAllocations            ResourceAllocation[]        @relation("ResourceAllocationUser")
  createdResourceAllocations     ResourceAllocation[]        @relation("ResourceAllocationCreatedBy")
  approvedResourceAllocations    ResourceAllocation[]        @relation("ResourceAllocationApprovedBy")
  costRateProfiles               CostRateProfile[]
  createdProjectBudgets          ProjectBudget[]             @relation("ProjectBudgetCreatedBy")
  createdProjectCosts            ProjectCost[]               @relation("ProjectCostCreatedBy")
  createdProjectPlSnapshots      ProjectPlSnapshot[]         @relation("ProjectPlSnapshotCreatedBy")
  ownedProjectStages             ProjectStage[]
  ownedTasks                     ProjectTask[]               @relation("ProjectTaskOwner")
  assignedTasks                  ProjectTask[]               @relation("ProjectTaskAssignee")
  createdTasks                   ProjectTask[]               @relation("ProjectTaskCreatedBy")
  archivedTasks                  ProjectTask[]               @relation("ProjectTaskArchivedBy")
  taskStatusChanges              TaskStatusHistory[]
  ticketStatusChanges            TicketStatusHistory[]       @relation("TicketStatusHistoryChangedBy")
  taskTimeEntries                TaskTimeEntry[]
  reviewedTaskTimeEntries        TaskTimeEntry[]             @relation("TaskTimeEntryReviewedBy")
  taskPlanningBlocks             TaskPlanningBlock[]
  lockedTaskPlanningBlocks       TaskPlanningBlock[]         @relation("TaskPlanningBlockLocker")
  ownedLeads                     Lead[]
  ownedOpportunities             Opportunity[]
  requestedTickets               Ticket[]
  customerGrants                 CustomerAccessGrant[]
  createdProgressShareLinks      ProjectProgressShareLink[]  @relation("ProgressShareCreatedBy")
  revokedProgressShareLinks      ProjectProgressShareLink[]  @relation("ProgressShareRevokedBy")
  createdFileObjects             FileObject[]                @relation("FileObjectCreatedBy")
  revokedFileObjects             FileObject[]                @relation("FileObjectRevokedBy")
  createdFileDownloadGrants      FileDownloadGrant[]         @relation("FileDownloadGrantCreatedBy")
  createdTaskComments            TaskComment[]               @relation("TaskCommentCreatedBy")
  deletedTaskComments            TaskComment[]               @relation("TaskCommentDeletedBy")
  createdProjectComments         ProjectComment[]            @relation("ProjectCommentCreatedBy")
  deletedProjectComments         ProjectComment[]            @relation("ProjectCommentDeletedBy")
  createdProjectActivities       ProjectActivity[]           @relation("ProjectActivityCreatedBy")
  ownedProjectRisks              ProjectRisk[]               @relation("ProjectRiskOwner")
  createdProjectRisks            ProjectRisk[]               @relation("ProjectRiskCreatedBy")
  createdTaskAttachments         TaskAttachment[]            @relation("TaskAttachmentCreatedBy")
  createdProjectAttachments      ProjectAttachment[]         @relation("ProjectAttachmentCreatedBy")
  createdProjectDocumentVersions ProjectDocumentVersion[]    @relation("ProjectDocumentVersionCreatedBy")
  policyDecisions                PolicyDecisionLog[]
  workspaceTeamMemberships       WorkspaceTeamMember[]
  workspaceMemberProfiles        WorkspaceMemberProfile[]
  analyticsSavedViews            AnalyticsSavedView[]        @relation("AnalyticsSavedViewOwner")
  createdWorkspaceDayOffs        WorkspaceDayOff[]           @relation("WorkspaceDayOffCreatedBy")
  approvedTaskPlans              ProjectTask[]               @relation("ProjectTaskPlanApprover")
  requestedTimelineChanges       TaskTimelineChangeRequest[] @relation("TimelineChangeRequestedBy")
  reviewedTimelineChanges        TaskTimelineChangeRequest[] @relation("TimelineChangeReviewedBy")
  changedTaskPlanHistories       TaskPlanHistory[]           @relation("TaskPlanHistoryChangedBy")
  approvedTaskPlanHistories      TaskPlanHistory[]           @relation("TaskPlanHistoryApprovedBy")
  requestedOvertimePlans         OvertimePlan[]              @relation("OvertimeRequestedBy")
  approvedOvertimePlans          OvertimePlan[]              @relation("OvertimeApprovedBy")
  overtimePlansForSelf           OvertimePlan[]              @relation("OvertimeForUser")
  monthlyCostProfiles            ResourceMonthlyCost[]
  confirmedPnlPeriods            PnlPeriod[]                 @relation("PnlPeriodConfirmedBy")
  lockedPnlPeriods               PnlPeriod[]                 @relation("PnlPeriodLockedBy")
  reopenedPnlPeriods             PnlPeriod[]                 @relation("PnlPeriodReopenedBy")
  reminderDeliveryLogs           ReminderDeliveryLog[]
  reminderPmLogs                 ReminderDeliveryLog[]       @relation("ReminderPm")
  updatedReminderPolicies        WorkspaceReminderPolicy[]   @relation("WorkspaceReminderPolicyUpdatedBy")
}

model TenantWorkspace {
  id                         String                      @id @default(cuid())
  tenantKey                  String
  workspaceKey               String
  name                       String
  status                     String                      @default("active")
  planCode                   String                      @default("foundation")
  regionCode                 String?
  createdAt                  DateTime                    @default(now())
  updatedAt                  DateTime                    @updatedAt
  sessions                   PortalSession[]
  roleBindings               RoleBinding[]
  accounts                   Account[]
  accountMembers             AccountMember[]
  accountUsageReviews        AccountUsageReview[]
  contacts                   Contact[]
  leads                      Lead[]
  opportunities              Opportunity[]
  proposalPackages           ProposalPackage[]
  proposalDocuments          ProposalDocument[]
  dealApprovalRequests       DealApprovalRequest[]
  dealApprovalDecisions      DealApprovalDecision[]
  contracts                  Contract[]
  contractDocuments          ContractDocument[]
  paymentSchedules           PaymentSchedule[]
  paymentMilestones          PaymentMilestone[]
  invoices                   Invoice[]
  invoicePayments            InvoicePayment[]
  arFollowUps                ArFollowUp[]
  paymentEvidence            PaymentEvidence[]
  opportunityActivities      OpportunityActivity[]
  opportunityStageHistory    OpportunityStageHistory[]
  projects                   Project[]
  milestoneTemplates         ProjectMilestoneTemplate[]
  projectMembers             ProjectMember[]
  projectMilestones          ProjectMilestone[]
  projectStages              ProjectStage[]
  resourceAllocations        ResourceAllocation[]
  resourceCapacityPeriods    ResourceCapacityPeriod[]
  projectBudgets             ProjectBudget[]
  projectCosts               ProjectCost[]
  projectPlSnapshots         ProjectPlSnapshot[]
  tickets                    Ticket[]
  ticketStatusHistory        TicketStatusHistory[]
  artifacts                  ProjectArtifact[]
  projectDocumentVersions    ProjectDocumentVersion[]
  files                      FileObject[]
  fileDownloadGrants         FileDownloadGrant[]
  projectTasks               ProjectTask[]
  taskComments               TaskComment[]
  projectComments            ProjectComment[]
  projectActivities          ProjectActivity[]
  projectRisks               ProjectRisk[]
  taskAttachments            TaskAttachment[]
  projectAttachments         ProjectAttachment[]
  taskStatusHistory          TaskStatusHistory[]
  taskTimeEntries            TaskTimeEntry[]
  taskPlanningBlocks         TaskPlanningBlock[]
  customerGrants             CustomerAccessGrant[]
  portalInvitations          PortalInvitation[]
  progressShareLinks         ProjectProgressShareLink[]
  policyDecisions            PolicyDecisionLog[]
  integrationEvents          IntegrationEventLog[]
  auditEvents                AuditEvent[]
  departments                Department[]
  workspaceTeams             WorkspaceTeam[]
  workspaceTeamMembers       WorkspaceTeamMember[]
  workspaceMemberProfiles    WorkspaceMemberProfile[]
  analyticsSavedViews        AnalyticsSavedView[]
  dayOffs                    WorkspaceDayOff[]
  taskTypeCatalogs           TaskTypeCatalog[]
  taskTimelineChangeRequests TaskTimelineChangeRequest[]
  taskPlanHistories          TaskPlanHistory[]
  overtimePlans              OvertimePlan[]
  monthlyCostProfiles        ResourceMonthlyCost[]
  pnlPeriods                 PnlPeriod[]
  pnlAllocations             PnlTimeEntryAllocation[]
  reminderDeliveryLogs       ReminderDeliveryLog[]
  reminderPolicy             WorkspaceReminderPolicy?

  @@unique([tenantKey, workspaceKey])
  @@index([status])
}

model PortalIdentity {
  id             String   @id @default(cuid())
  userId         String
  provider       String
  providerUserId String
  tenantKey      String
  createdAt      DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id])

  @@unique([provider, providerUserId, tenantKey])
  @@index([tenantKey])
}

model PortalSession {
  authMethod      String          @default("legacy")
  userAgent       String?
  ipAddress       String?
  mfaVerifiedAt   DateTime?
  authenticatedAt DateTime        @default(now())
  id              String          @id @default(cuid())
  userId          String
  tenantKey       String
  workspaceId     String          @default("twk-foundation")
  tokenHash       String          @unique
  roleVersion     String
  grantVersion    String
  expiresAt       DateTime
  lastSeenAt      DateTime        @default(now())
  revokedAt       DateTime?
  createdAt       DateTime        @default(now())
  user            User            @relation(fields: [userId], references: [id])
  workspace       TenantWorkspace @relation(fields: [workspaceId], references: [id])

  @@index([userId])
  @@index([tenantKey])
  @@index([workspaceId])
  @@index([expiresAt])
}

model Role {
  id             String          @id @default(cuid())
  code           String          @unique
  name           String
  type           RoleType
  description    String?
  createdAt      DateTime        @default(now())
  permissionSets PermissionSet[]
  bindings       RoleBinding[]
}

model PermissionSet {
  id              String          @id @default(cuid())
  roleId          String
  action          Action
  resource        Resource
  scope           ScopeType
  defaultDecision DefaultDecision @default(DENY)
  createdAt       DateTime        @default(now())
  role            Role            @relation(fields: [roleId], references: [id])

  @@index([resource, action])
}

model RoleBinding {
  id          String           @id @default(cuid())
  userId      String
  roleId      String
  tenantKey   String
  workspaceId String?
  startsAt    DateTime         @default(now())
  endsAt      DateTime?
  createdAt   DateTime         @default(now())
  user        User             @relation(fields: [userId], references: [id])
  role        Role             @relation(fields: [roleId], references: [id])
  workspace   TenantWorkspace? @relation(fields: [workspaceId], references: [id])

  @@unique([userId, roleId, tenantKey, workspaceId])
  @@index([tenantKey])
  @@index([workspaceId])
  @@index([userId, roleId])
}

model Team {
  id        String        @id @default(cuid())
  code      String        @unique
  name      String
  createdAt DateTime      @default(now())
  members   TeamMember[]
  accounts  Account[]
  tasks     ProjectTask[]
}

model TeamMember {
  id        String   @id @default(cuid())
  teamId    String
  userId    String
  createdAt DateTime @default(now())
  team      Team     @relation(fields: [teamId], references: [id])

  @@unique([teamId, userId])
}

model Account {
  id                      String                     @id @default(cuid())
  workspaceId             String                     @default("twk-foundation")
  code                    String
  name                    String
  stage                   String
  ownerTeamId             String?
  picUserId               String?
  annualValue             Decimal                    @default(0)
  commercialNote          String?
  createdAt               DateTime                   @default(now())
  updatedAt               DateTime                   @updatedAt
  workspace               TenantWorkspace            @relation(fields: [workspaceId], references: [id])
  ownerTeam               Team?                      @relation(fields: [ownerTeamId], references: [id])
  picUser                 User?                      @relation("AccountPic", fields: [picUserId], references: [id])
  members                 AccountMember[]
  contacts                Contact[]
  usageReviews            AccountUsageReview[]
  leads                   Lead[]
  projects                Project[]
  opportunities           Opportunity[]
  proposalPackages        ProposalPackage[]
  contracts               Contract[]
  paymentSchedules        PaymentSchedule[]
  paymentMilestones       PaymentMilestone[]
  invoices                Invoice[]
  invoicePayments         InvoicePayment[]
  arFollowUps             ArFollowUp[]
  paymentEvidence         PaymentEvidence[]
  resourceAllocations     ResourceAllocation[]
  projectBudgets          ProjectBudget[]
  projectCosts            ProjectCost[]
  projectPlSnapshots      ProjectPlSnapshot[]
  activities              OpportunityActivity[]
  stageHistory            OpportunityStageHistory[]
  customerGrants          CustomerAccessGrant[]
  tickets                 Ticket[]
  ticketStatusHistory     TicketStatusHistory[]
  artifacts               ProjectArtifact[]
  projectDocumentVersions ProjectDocumentVersion[]
  files                   FileObject[]
  taskComments            TaskComment[]
  projectComments         ProjectComment[]
  projectActivities       ProjectActivity[]
  projectRisks            ProjectRisk[]
  taskAttachments         TaskAttachment[]
  projectAttachments      ProjectAttachment[]
  progressShareLinks      ProjectProgressShareLink[]
  projectMilestones       ProjectMilestone[]
  projectStages           ProjectStage[]
  tasks                   ProjectTask[]
  taskPlanningBlocks      TaskPlanningBlock[]

  @@unique([workspaceId, code])
  @@index([workspaceId, stage])
  @@index([stage])
  @@index([ownerTeamId])
  @@index([picUserId])
}

model AccountMember {
  id          String                @id @default(cuid())
  workspaceId String                @default("twk-foundation")
  accountId   String
  userId      String
  relation    AccountMemberRelation
  createdAt   DateTime              @default(now())
  workspace   TenantWorkspace       @relation(fields: [workspaceId], references: [id])
  account     Account               @relation(fields: [accountId], references: [id])
  user        User                  @relation(fields: [userId], references: [id])

  @@unique([workspaceId, accountId, userId, relation])
  @@index([workspaceId, userId])
  @@index([userId])
}

model AccountUsageReview {
  id                   String          @id @default(cuid())
  workspaceId          String          @default("twk-foundation")
  accountId            String
  month                String
  dataSource           String
  confidence           String
  metricsAvailable     Boolean         @default(true)
  unavailabilityReason String?
  licensedUsers        Int?
  activeUsersMau       Int?
  adoptionRate         Decimal?
  weeklyActivityWeeks  Int?
  docsUsage            Int?
  baseUsage            Int?
  taskUsage            Int?
  workflowUsage        Int?
  ticketCount          Int?
  slaBreaches          Int?
  csat                 Int?
  trainingAttendance   Int?
  healthScore          String
  interpretation       String?
  expansionSignal      String
  nextAction           String
  nextReviewDate       DateTime?
  owner                String
  escalationOwner      String?
  escalationNote       String?
  createdByUserId      String?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  workspace            TenantWorkspace @relation(fields: [workspaceId], references: [id])
  account              Account         @relation(fields: [accountId], references: [id])
  createdBy            User?           @relation(fields: [createdByUserId], references: [id])

  @@index([workspaceId, accountId, month])
  @@index([accountId, month])
  @@index([createdByUserId])
}

model Contact {
  id          String          @id @default(cuid())
  workspaceId String          @default("twk-foundation")
  accountId   String
  name        String
  email       String?
  phone       String?
  role        String?
  influence   String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  workspace   TenantWorkspace @relation(fields: [workspaceId], references: [id])
  account     Account         @relation(fields: [accountId], references: [id])
  leads       Lead[]

  @@unique([workspaceId, email])
  @@index([workspaceId])
  @@index([accountId])
  @@index([name])
}

model Lead {
  id                   String          @id @default(cuid())
  workspaceId          String          @default("twk-foundation")
  accountId            String
  contactId            String?
  companyName          String
  contactName          String
  contactEmail         String?
  source               String
  painPoint            String?
  serviceFit           String?
  timeline             String?
  budgetRange          String?
  authority            String?
  status               String          @default("captured")
  ownerUserId          String?
  duplicateOfLeadId    String?
  duplicateReason      String?
  qualificationSummary String?
  nextActivityAt       DateTime?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  workspace            TenantWorkspace @relation(fields: [workspaceId], references: [id])
  account              Account         @relation(fields: [accountId], references: [id])
  contact              Contact?        @relation(fields: [contactId], references: [id])
  owner                User?           @relation(fields: [ownerUserId], references: [id])
  duplicateOf          Lead?           @relation("LeadDuplicate", fields: [duplicateOfLeadId], references: [id])
  duplicates           Lead[]          @relation("LeadDuplicate")
  opportunities        Opportunity[]

  @@index([workspaceId, status])
  @@index([accountId, status])
  @@index([contactId])
  @@index([ownerUserId])
  @@index([duplicateOfLeadId])
  @@index([contactEmail])
}

model Opportunity {
  id                  String                    @id @default(cuid())
  workspaceId         String                    @default("twk-foundation")
  accountId           String
  leadId              String?
  title               String
  ownerUserId         String?
  stage               String
  amount              Decimal                   @default(0)
  probability         Int                       @default(0)
  forecastCategory    String                    @default("pipeline")
  stageEnteredAt      DateTime                  @default(now())
  closedAt            DateTime?
  closeReason         String?
  handoffConfirmedAt  DateTime?
  handoffChecklist    Json?
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt
  workspace           TenantWorkspace           @relation(fields: [workspaceId], references: [id])
  account             Account                   @relation(fields: [accountId], references: [id])
  lead                Lead?                     @relation(fields: [leadId], references: [id])
  owner               User?                     @relation(fields: [ownerUserId], references: [id])
  activities          OpportunityActivity[]
  stageHistory        OpportunityStageHistory[]
  proposalPackages    ProposalPackage[]
  contracts           Contract[]
  paymentSchedules    PaymentSchedule[]
  resourceAllocations ResourceAllocation[]
  tasks               ProjectTask[]
  projects            Project[]

  @@unique([workspaceId, accountId, title])
  @@index([workspaceId, stage])
  @@index([accountId, stage])
  @@index([leadId])
  @@index([ownerUserId])
  @@index([forecastCategory])
  @@index([stageEnteredAt])
  @@index([closedAt])
}

model ProposalPackage {
  id                 String                @id @default(cuid())
  workspaceId        String                @default("twk-foundation")
  accountId          String
  opportunityId      String
  packageType        ProposalPackageType
  status             ProposalPackageStatus @default(DRAFT)
  version            Int                   @default(1)
  title              String
  currency           String                @default("VND")
  proposedAmount     Decimal               @default(0)
  discountPercent    Decimal               @default(0)
  paymentTermSummary String?
  scopeRiskLevel     ScopeRiskLevel        @default(LOW)
  customerVisible    Boolean               @default(false)
  createdByUserId    String?
  submittedAt        DateTime?
  approvedAt         DateTime?
  sentAt             DateTime?
  acceptedAt         DateTime?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  workspace          TenantWorkspace       @relation(fields: [workspaceId], references: [id])
  account            Account               @relation(fields: [accountId], references: [id])
  opportunity        Opportunity           @relation(fields: [opportunityId], references: [id])
  documents          ProposalDocument[]
  approvalRequests   DealApprovalRequest[]
  contracts          Contract[]
  paymentSchedules   PaymentSchedule[]

  @@unique([workspaceId, opportunityId, version])
  @@index([workspaceId, status])
  @@index([accountId, status])
  @@index([opportunityId, status])
  @@index([packageType, status])
}

model ProposalDocument {
  id                String               @id @default(cuid())
  workspaceId       String               @default("twk-foundation")
  proposalPackageId String
  documentType      ProposalDocumentType
  version           Int                  @default(1)
  title             String
  storageProvider   String               @default("lark_drive")
  storageKey        String?
  externalUrl       String?
  customerVisible   Boolean              @default(false)
