API_PORT=4403
APP_PUBLIC_ORIGIN=http://localhost:3003
PUBLIC_APP_URL=http://localhost:3003
# Origin tin cậy cho Auth cục bộ. Production phải thay bằng HTTPS domain thực tế.
PUBLIC_WEB_URL=http://localhost:3003
API_HOST_PORT=4400
WEB_HOST_PORT=3004
POSTGRES_DB=lark_partner_crm_dev
POSTGRES_USER=lark_partner_crm_dev
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=55438
APP_DATABASE_USER=b2b_crm_saas_app
APP_DATABASE_PASSWORD=change-me-app-role
REDIS_PASSWORD=change-me
REDIS_PORT=56388
DATABASE_URL=postgresql://lark_partner_crm_dev:change-me@127.0.0.1:55438/lark_partner_crm_dev?schema=public
MIGRATION_DATABASE_URL=postgresql://lark_partner_crm_dev:change-me@127.0.0.1:55438/lark_partner_crm_dev?schema=public
REDIS_URL=redis://:change-me@127.0.0.1:56388/0
APP_REDIS_URL=redis://:change-me@redis:6379/0
CRM_API_INTERNAL_URL=http://127.0.0.1:4403
NEXT_PUBLIC_API_URL=http://localhost:3003/api
CRM_API_CORS_ORIGINS=http://localhost:3003
CRM_READY_DETAIL_ENABLED=false
# Local-only shortcut on the login page; keep false outside development.
CRM_DEMO_AUTH_ENABLED=false
CRM_ALLOW_PRINCIPAL_FALLBACK=false
CRM_LOCAL_AUTO_AUTH=false
NEXT_PUBLIC_LOCAL_AUTO_AUTH=false
WORKFORCE_ANALYTICS_GA_ENABLED=false
FOUNDATION_TENANT_KEY=prod
FOUNDATION_WORKSPACE_ID=twk-foundation
FOUNDATION_WORKSPACE_KEY=default
FOUNDATION_WORKSPACE_NAME="Default Workspace"
FOUNDATION_WORKSPACE_PLAN=foundation
FOUNDATION_ADMIN_EMAIL=admin@example.com
FOUNDATION_ADMIN_NAME="Founder GM"
FOUNDATION_ADMIN_USER_ID=usr-local-admin
FOUNDATION_ADMIN_LARK_OPEN_IDS=
FOUNDATION_PRODUCTION_STRICT=true
ALLOW_DEMO_SEED_IN_PRODUCTION=false
LARK_APP_ID=cli_xxx
LARK_APP_SECRET=change-me
LARK_OAUTH_STATE_SECRET=change-me
LARK_OAUTH_SCOPES="contact:user.email:readonly contact:user.employee_id:readonly"
LARK_ALLOWED_TENANT_KEYS=
CRM_LARK_AUTO_PROVISION=false
# Native Auth: no public signup. Founder invitations are the registration path.
CRM_AUTH_PUBLIC_ORIGIN=http://localhost:3003
# Generate 32 random bytes encoded as 64 hex characters; keep stable and backed up for MFA decryption.
CRM_AUTH_ENCRYPTION_KEY=
CRM_AUTH_MAIL_MODE=smtp
CRM_AUTH_MAIL_FROM=
CRM_AUTH_SMTP_URL=
# Local development may use explicit spool mode; never enabled in production.
CRM_AUTH_MAIL_SPOOL=
CRM_LOCAL_AUTH_ENABLED=false
# API guard for the local founder session; keep false outside development.
CRM_ENABLE_DEMO_SESSION=false
CRM_ENABLE_DIRECT_LARK_SESSION=false
LARK_OAUTH_REDIRECT_URIS=http://localhost:3003/api/auth/lark/callback
CRM_LARK_DEFAULT_ROLE_CODE=SALES_OWNER
# Contact directory sync is additive-only and disabled until explicitly enabled on the worker.
LARK_CDS_DEPARTMENT_ID=your-department-id
LARK_CDS_DEPARTMENT_ID_TYPE=department_id
LARK_DIRECTORY_SYNC_ENABLED=false
LARK_DIRECTORY_SYNC_INTERVAL_MS=900000
LARK_DIRECTORY_SYNC_STARTUP_DELAY_MS=60000
LARK_DIRECTORY_SYNC_LEASE_TTL_MS=1200000
LARK_DIRECTORY_SYNC_HEARTBEAT_MS=30000
LARK_DIRECTORY_HTTP_TIMEOUT_MS=15000
LARK_DIRECTORY_RETRY_ATTEMPTS=3
# EV-060 Task/Actual reminder. Disabled by default; webhook belongs to one Lark chat.
LARK_TASK_REMINDER_ENABLED=false
LARK_TASK_REMINDER_WORKSPACE_ID=twk-foundation
LARK_TASK_REMINDER_WEBHOOK_URL=
# Optional custom-bot signing secret. Keep outside source control.
LARK_TASK_REMINDER_WEBHOOK_SECRET=
# Reserved for a future PM summary slot (currently disabled).
LARK_TASK_REMINDER_PM_OPEN_IDS=
# Optional pilot allowlist of CRM user IDs. Empty means all active internal project members.
LARK_TASK_REMINDER_USER_IDS=
# Vietnam public holidays or other full-workspace days off, YYYY-MM-DD comma-separated.
LARK_TASK_REMINDER_EXCLUDED_DATES=
LARK_TASK_REMINDER_TARGET_MINUTES=480
LARK_TASK_REMINDER_CATCH_UP_MINUTES=60
LARK_TASK_REMINDER_POLL_INTERVAL_MS=30000
LARK_TASK_REMINDER_STARTUP_DELAY_MS=5000
IMAGE_REGISTRY=ghcr.io/upbase-dx/lark-partner-crm
IMAGE_TAG=sha-change-me
